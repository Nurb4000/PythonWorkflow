<?xml version="1.0" encoding="UTF-8"?>
<WorkflowPackage version="1.0" exportedAt="2026-01-01T00:00:00Z" sourceSystem="PythonWorkflow">
  <Metadata>
    <Name>Hello World Workflow</Name>
    <Description>A simple linear workflow that makes an API call and sends an email notification. Great for testing import/export.</Description>
    <Author>Demo</Author>
  </Metadata>

  <Workflow name="Hello World" isPublished="false" environment="test" isActive="true" version="1">
    <Portal icon="👋" order="1" visible="true" />
    <Config>
      <StartStepIds>step-1</StartStepIds>
    </Config>

    <Steps>
      <Step id="step-1" type="api_call" position="0" isEnabled="true">
        <Title>Fetch Data</Title>
        <Description>Make a GET request to an external API</Description>
        <Definition>{"method":"GET","url":"https://jsonplaceholder.typicode.com/posts/1","headers":{},"next_step_ids":["step-2"]}</Definition>
      </Step>

      <Step id="step-2" type="email" position="1" isEnabled="true">
        <Title>Send Notification</Title>
        <Description>Send email with API response data</Description>
        <Definition>{"to":"admin@example.com","subject":"Hello World Complete","body":"API response: $input.output_data","next_step_ids":[]}</Definition>
      </Step>
    </Steps>

    <Schedules />
    <Permissions />
  </Workflow>

  <Forms />
  <Groups />
</WorkflowPackage>
