# PythonWorkflow backend configuration
# Copy to backend/.env (or export in your shell / docker-compose environment).

# Database (PostgreSQL only).
# L3 fix: do not commit real credentials. Supply them via your environment or
# secret manager. Example using shell variables:
#   DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@postgres:5432/workflow_db
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/workflow_db

# Test database used by `make test-backend` / backend/tests/conftest.py
TEST_DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/workflow_db_test

# Security — CHANGE THIS in any real deployment
SECRET_KEY=CHANGE_ME_generate_a_long_random_value

# AI service (optional, for step generation / assist endpoints).
# Local inference (no API key): keep AI_PROVIDER=llama_cpp and point LLAMA_CPP_URL at a
#   local llama.cpp server.
# Cloud inference: set AI_PROVIDER=openai and OPENAI_API_KEY to use OpenAI or any
#   OpenAI-compatible endpoint (override OPENAI_BASE_URL for third-party gateways).
AI_PROVIDER=llama_cpp
LLAMA_CPP_URL=http://localhost:8081
LLAMA_CPP_MODEL=default
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# SMTP (leave host empty to disable email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@pythonworkflow.local
SMTP_TLS=true
ADMIN_NOTIFY_EMAIL=

# Webhook authentication (leave empty to disable secret verification)
WEBHOOK_SECRET=

# Scheduler
SCHEDULER_TIMEZONE=UTC

# API rate limiting (M5)
API_REQUESTS_PER_WINDOW=60
API_REQUEST_WINDOW_SECONDS=60

# Export alerting (G7): cap/rate-limit events go to configured admin channels.
EXPORT_ALERTS_ENABLED=true
EXPORT_ALERT_COOLDOWN_SECONDS=300
# Optional admin notification channels (email uses ADMIN_NOTIFY_EMAIL above).
SLACK_WEBHOOK_URL=
WEBHOOK_URL=
