# PythonWorkflow backend configuration
# Copy to backend/.env (or export in your shell / docker-compose environment).

# Database (PostgreSQL only)
DATABASE_URL=postgresql+asyncpg://workflow_user:workflow_password@postgres:5432/workflow_db

# Test database used by `make test-backend` / backend/tests/conftest.py
TEST_DATABASE_URL=postgresql+asyncpg://workflow_user:workflow_password@postgres:5432/workflow_db_test

# Security — CHANGE THIS in any real deployment
SECRET_KEY=dwrCE1-KNoe2t_-gB6LgBpI_3nCd1iRqvc5VKvlR3F8sOxL7h1y_87fmKK_ovZ3-

# AI service (optional, for step generation / assist endpoints)
LLAMA_CPP_URL=http://localhost:8081
LLAMA_CPP_MODEL=default

# SMTP (leave host empty to disable email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@pythonworkflow.local
SMTP_TLS=true
ADMIN_NOTIFY_EMAIL=

# Webhook authentication (leave empty to disable secret verification)
WEBHOOK_SECRET=

# Scheduler
SCHEDULER_TIMEZONE=UTC
